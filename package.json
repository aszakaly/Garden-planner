{
  "name": "kerttervezo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kert- és veteményes-tervező és kertészeti napló – saját használatra",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n server,client -c green,blue \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "dev:sandbox": "KERT_PORT=4331 KERT_DB=data/sandbox.db concurrently -k -n server,client -c green,blue \"tsx watch src/server/index.ts\" \"vite --port 5180 --strictPort\"",
    "build": "vite build",
    "start": "npm run build && NODE_ENV=production tsx src/server/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "@tanstack/react-query": "^5.104.0",
    "fastify": "^5.12.5",
    "lucide-react": "^1.49.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.3"
  }
}
